PORT=5000
MONGO_URI=mongodb://localhost:27017/sih-analyzer
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback provider. The app runs Gemini-only when blank.
# Groq is attempted only if Gemini fails transiently (429/5xx/timeout).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Per-attempt timeouts in ms (defaults shown).
GEMINI_REQUEST_TIMEOUT_MS=60000
GROQ_REQUEST_TIMEOUT_MS=45000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173