# Backend API base URL for the SIH Intelligent Problem Analyzer frontend.
#
# For a production deployment (e.g. Vercel) this MUST point to your Render
# backend. Set it as a build-time environment variable on your frontend host.
#
# Examples:
#   VITE_API_URL=https://sih-intelligence.onrender.com
#   VITE_API_URL=http://localhost:5000   (local development)
#
# Note: if this is left blank on a production build, the app fails loudly
# instead of silently calling localhost.
VITE_API_URL=
